# ============================================================
# Emma - Outbound Sales Agent  ::  environment configuration
# Copy to ".env" and fill in. Never commit the real .env.
# ============================================================

# --- ElevenLabs Agents (the agent platform: brain + voice + calling) ---
# API key from https://elevenlabs.io  ->  profile menu  ->  API Keys
ELEVENLABS_API_KEY=
# Paste your agent's ID from the ElevenLabs dashboard.
ELEVENLABS_AGENT_ID=
# Filled automatically by `emma import-number`. Leave blank.
ELEVENLABS_PHONE_NUMBER_ID=
# Shared secret. HMAC-verifies the post-call webhook and guards the
# Cal.com tool endpoints. Use any long random string.
ELEVENLABS_WEBHOOK_SECRET=
# Optional bearer token guarding the dashboard /api/* endpoints. Empty = open.
DASHBOARD_TOKEN=
# Note: Emma's voice and LLM are configured on the agent in the
# ElevenLabs dashboard, not here.

# --- Twilio (UK phone number Emma calls FROM) ---
# ElevenLabs places the calls; it only needs the number + credentials.
# Buy a UK (+44) number in the Twilio console, then import it via the CLI.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your purchased number in E.164 form, e.g. +447700900123
TWILIO_PHONE_NUMBER=

# --- Cal.com (books the meeting with the practice decision-maker) ---
# Optional - without it, booking falls back to provisional weekday slots.
# API key: Cal.com -> Settings -> Developer -> API Keys
CALCOM_API_KEY=
# Numeric event-type id of the "Discovery Call" event you want booked.
CALCOM_EVENT_TYPE_ID=

# --- Webhook server ---
# Public HTTPS URL ElevenLabs can reach for tool calls + the post-call
# report. In development run `ngrok http 8000` and paste the https URL.
SERVER_URL=

# --- Demo ---
# A UK mobile (E.164, e.g. +447700900123) for the test call where you keep
# saying "no". Use your own number to try it.
TARGET_TEST_NUMBER=

# --- Identity (optional - sensible defaults in config.py) ---
# COMPANY_NAME=QuantumLoopAI
# AGENT_NAME=Emma
# TIMEZONE=Europe/London
